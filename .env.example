# Local Homebrew Postgres 16.14. NOTE: bare `psql` fails with
# 'FATAL: database "<user>" does not exist', so always pass -d or set PGDATABASE.
# The role MUST be explicit: sqlx does not fall back to the OS user and will
# connect as role "anonymous", which does not exist.
DATABASE_URL=postgres://YOUR_LOCAL_ROLE@localhost:5432/rxbill
PORT=8080
RUST_LOG=rxbill_api=debug,tower_http=debug,info

# CI ONLY. Setting this in .env breaks `cargo sqlx prepare` itself.
# SQLX_OFFLINE=true
